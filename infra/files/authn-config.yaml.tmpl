---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  jwt:
    - issuer:
        url: ${cluster_oidc_issuer}
        audiences:
          - ${cluster_oidc_client_id}
        audienceMatchPolicy: MatchAny
      claimMappings:
        username:
          claim: preferred_username
          prefix: ""
        groups:
          claim: groups
          prefix: "oidc:"
        uid:
          claim: "sub"
